{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Schema Adapter Agent (copy file)",
      "type": "debugpy",
      "request": "launch",
      "module": "schema_adapter_agent",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Schema Adapter Agent (custom file)",
      "type": "debugpy",
      "request": "launch",
      "module": "schema_adapter_agent",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "envFile": "${workspaceFolder}/.env",
      "args": ["${input:inputFile}"]
    },
    {
      "name": "Code Gen Agent (copy file)",
      "type": "debugpy",
      "request": "launch",
      "module": "code_gen_agent",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Code Gen Agent (custom file)",
      "type": "debugpy",
      "request": "launch",
      "module": "code_gen_agent",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "envFile": "${workspaceFolder}/.env",
      "args": ["${input:inputFile}"]
    },
    {
      "name": "FastAPI Debug",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["api.main:app", "--reload", "--port", "8000", "--reload-exclude", "logs/*", "--reload-exclude", "uploads/*", "--reload-exclude", "outputs/*", "--reload-exclude", "generated_scripts/*", "--reload-exclude", "data/*"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Process (execution agent)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/code/process.py",
      "args": ["${input:inputFile}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "envFile": "${workspaceFolder}/.env"
    }
  ],
  "inputs": [
    {
      "id": "inputFile",
      "type": "promptString",
      "description": "Path to Excel input file",
      "default": "./inputs/[Simple] Bill processing_tampered.xlsx"
    }
  ]
}
